{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codehub.internal/schemas/codehub-cli-v1-error.json",
  "title": "CodeHub CLI v1 error envelope",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "request_id",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "codehub.cli/v1"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "http_status",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
