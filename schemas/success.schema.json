{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codehub.internal/schemas/codehub-cli-v1-success.json",
  "title": "CodeHub CLI v1 success envelope",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "request_id",
    "data",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "codehub.cli/v1"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "data": {},
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
