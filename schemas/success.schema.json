{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codehub.internal/schemas/codehub-cli-v1-success.json",
  "title": "CodeHub CLI v1 success envelope",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "request_id",
    "data",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "codehub.cli/v1"
    },
    "command": {
      "enum": [
        "version",
        "capabilities",
        "auth.login",
        "auth.status",
        "auth.logout",
        "repo.list",
        "repo.view",
        "mr.list",
        "mr.view",
        "mr.commits",
        "mr.comment.create"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "data": {},
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "command": { "const": "version" },
        "data": { "$ref": "#/$defs/version" }
      }
    },
    {
      "properties": {
        "command": { "const": "capabilities" },
        "data": { "$ref": "#/$defs/capabilities" }
      }
    },
    {
      "properties": {
        "command": { "const": "auth.login" },
        "data": { "$ref": "#/$defs/authLogin" }
      }
    },
    {
      "properties": {
        "command": { "const": "auth.status" },
        "data": { "$ref": "#/$defs/authStatus" }
      }
    },
    {
      "properties": {
        "command": { "const": "auth.logout" },
        "data": { "$ref": "#/$defs/authLogout" }
      }
    },
    {
      "properties": {
        "command": { "const": "repo.list" },
        "data": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoSummary" }
        }
      }
    },
    {
      "properties": {
        "command": { "const": "repo.view" },
        "data": { "$ref": "#/$defs/repoDetail" }
      }
    },
    {
      "properties": {
        "command": { "const": "mr.list" },
        "data": {
          "type": "array",
          "items": { "$ref": "#/$defs/mrSummary" }
        }
      }
    },
    {
      "properties": {
        "command": { "const": "mr.view" },
        "data": { "$ref": "#/$defs/mrDetail" }
      }
    },
    {
      "properties": {
        "command": { "const": "mr.commits" },
        "data": {
          "type": "array",
          "items": { "$ref": "#/$defs/commit" }
        }
      }
    },
    {
      "properties": {
        "command": { "const": "mr.comment.create" },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/commentDryRun" },
            { "$ref": "#/$defs/commentResult" }
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "nullableBoolean": {
      "type": ["boolean", "null"]
    },
    "nullableNumber": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "required": [
        "cli_version",
        "protocol_version",
        "node_version",
        "platform",
        "arch"
      ],
      "properties": {
        "cli_version": { "type": "string" },
        "protocol_version": { "const": "codehub.cli/v1" },
        "node_version": { "type": "string" },
        "platform": { "type": "string" },
        "arch": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "authentication_methods",
        "read_commands",
        "write_commands",
        "pagination_guaranteed",
        "conditional_write",
        "idempotent_write",
        "inline_discussion",
        "write_requires_confirmation",
        "write_auto_retry"
      ],
      "properties": {
        "authentication_methods": {
          "type": "array",
          "items": { "type": "string" }
        },
        "read_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "write_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pagination_guaranteed": { "type": "boolean" },
        "conditional_write": { "type": "boolean" },
        "idempotent_write": { "type": "boolean" },
        "inline_discussion": { "type": "boolean" },
        "write_requires_confirmation": { "type": "boolean" },
        "write_auto_retry": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "authLogin": {
      "type": "object",
      "required": [
        "configured",
        "credential_source",
        "authentication_type",
        "api_host"
      ],
      "properties": {
        "configured": { "const": true },
        "credential_source": { "type": "string" },
        "authentication_type": { "type": "string" },
        "api_host": { "type": "string" }
      },
      "additionalProperties": false
    },
    "authStatus": {
      "type": "object",
      "required": [
        "configured",
        "credential_source",
        "authentication_type",
        "api_host"
      ],
      "properties": {
        "configured": { "type": "boolean" },
        "credential_source": { "$ref": "#/$defs/nullableString" },
        "authentication_type": { "$ref": "#/$defs/nullableString" },
        "api_host": { "type": "string" }
      },
      "additionalProperties": false
    },
    "authLogout": {
      "type": "object",
      "required": ["credential_helper_cleared", "api_host"],
      "properties": {
        "credential_helper_cleared": { "const": true },
        "api_host": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cloneUrls": {
      "type": "object",
      "required": ["ssh", "https"],
      "properties": {
        "ssh": { "$ref": "#/$defs/nullableString" },
        "https": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "repoSummary": {
      "type": "object",
      "required": [
        "repo_id",
        "full_name",
        "clone_urls",
        "archived",
        "updated_at"
      ],
      "properties": {
        "repo_id": { "$ref": "#/$defs/nullableString" },
        "full_name": { "$ref": "#/$defs/nullableString" },
        "clone_urls": { "$ref": "#/$defs/cloneUrls" },
        "archived": { "$ref": "#/$defs/nullableBoolean" },
        "updated_at": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "repoDetail": {
      "type": "object",
      "required": [
        "repo_id",
        "full_name",
        "clone_urls",
        "archived",
        "updated_at",
        "default_branch",
        "web_url"
      ],
      "properties": {
        "repo_id": { "$ref": "#/$defs/nullableString" },
        "full_name": { "$ref": "#/$defs/nullableString" },
        "clone_urls": { "$ref": "#/$defs/cloneUrls" },
        "archived": { "$ref": "#/$defs/nullableBoolean" },
        "updated_at": { "$ref": "#/$defs/nullableString" },
        "default_branch": { "$ref": "#/$defs/nullableString" },
        "web_url": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "user": {
      "type": "object",
      "required": ["id", "username", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/nullableString" },
        "username": { "$ref": "#/$defs/nullableString" },
        "name": { "$ref": "#/$defs/nullableString" },
        "type": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "mrSummary": {
      "type": "object",
      "required": [
        "repo_id",
        "mr_id",
        "iid",
        "title",
        "state",
        "is_draft",
        "author",
        "source_branch",
        "target_branch",
        "updated_at",
        "web_url"
      ],
      "properties": {
        "repo_id": { "$ref": "#/$defs/nullableString" },
        "mr_id": { "$ref": "#/$defs/nullableString" },
        "iid": { "$ref": "#/$defs/nullableString" },
        "title": { "$ref": "#/$defs/nullableString" },
        "state": { "$ref": "#/$defs/nullableString" },
        "is_draft": { "$ref": "#/$defs/nullableBoolean" },
        "author": {
          "oneOf": [
            { "$ref": "#/$defs/user" },
            { "type": "null" }
          ]
        },
        "source_branch": { "$ref": "#/$defs/nullableString" },
        "target_branch": { "$ref": "#/$defs/nullableString" },
        "updated_at": { "$ref": "#/$defs/nullableString" },
        "web_url": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "object",
      "required": ["files", "additions", "deletions"],
      "properties": {
        "files": { "$ref": "#/$defs/nullableNumber" },
        "additions": { "$ref": "#/$defs/nullableNumber" },
        "deletions": { "$ref": "#/$defs/nullableNumber" }
      },
      "additionalProperties": false
    },
    "mrDetail": {
      "type": "object",
      "required": [
        "repo_id",
        "mr_id",
        "iid",
        "title",
        "state",
        "is_draft",
        "author",
        "source_branch",
        "target_branch",
        "updated_at",
        "web_url",
        "description",
        "labels",
        "created_at",
        "changes"
      ],
      "properties": {
        "repo_id": { "$ref": "#/$defs/nullableString" },
        "mr_id": { "$ref": "#/$defs/nullableString" },
        "iid": { "$ref": "#/$defs/nullableString" },
        "title": { "$ref": "#/$defs/nullableString" },
        "state": { "$ref": "#/$defs/nullableString" },
        "is_draft": { "$ref": "#/$defs/nullableBoolean" },
        "author": {
          "oneOf": [
            { "$ref": "#/$defs/user" },
            { "type": "null" }
          ]
        },
        "source_branch": { "$ref": "#/$defs/nullableString" },
        "target_branch": { "$ref": "#/$defs/nullableString" },
        "updated_at": { "$ref": "#/$defs/nullableString" },
        "web_url": { "$ref": "#/$defs/nullableString" },
        "description": { "$ref": "#/$defs/nullableString" },
        "labels": {
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "string" }
            },
            { "type": "null" }
          ]
        },
        "created_at": { "$ref": "#/$defs/nullableString" },
        "changes": { "$ref": "#/$defs/changes" }
      },
      "additionalProperties": false
    },
    "person": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": { "$ref": "#/$defs/nullableString" },
        "email": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "required": [
        "sha",
        "title",
        "message",
        "author",
        "committer",
        "authored_at",
        "committed_at",
        "parent_shas"
      ],
      "properties": {
        "sha": { "$ref": "#/$defs/nullableString" },
        "title": { "$ref": "#/$defs/nullableString" },
        "message": { "$ref": "#/$defs/nullableString" },
        "author": {
          "oneOf": [
            { "$ref": "#/$defs/person" },
            { "type": "null" }
          ]
        },
        "committer": {
          "oneOf": [
            { "$ref": "#/$defs/person" },
            { "type": "null" }
          ]
        },
        "authored_at": { "$ref": "#/$defs/nullableString" },
        "committed_at": { "$ref": "#/$defs/nullableString" },
        "parent_shas": {
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "string" }
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "commentDryRun": {
      "type": "object",
      "required": [
        "dry_run",
        "repo_id",
        "mr_iid",
        "severity",
        "body_utf8_bytes",
        "authentication_type"
      ],
      "properties": {
        "dry_run": { "const": true },
        "repo_id": { "type": "string" },
        "mr_iid": { "type": "string" },
        "severity": { "type": "string" },
        "body_utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "authentication_type": { "type": "string" }
      },
      "additionalProperties": false
    },
    "commentResult": {
      "type": "object",
      "required": [
        "comment_id",
        "repo_id",
        "mr_iid",
        "severity",
        "resolved",
        "web_url"
      ],
      "properties": {
        "comment_id": { "$ref": "#/$defs/nullableString" },
        "repo_id": { "$ref": "#/$defs/nullableString" },
        "mr_iid": { "$ref": "#/$defs/nullableString" },
        "severity": { "$ref": "#/$defs/nullableString" },
        "resolved": { "$ref": "#/$defs/nullableBoolean" },
        "web_url": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    }
  }
}
