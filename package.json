{
  "name": "codehub-cli",
  "version": "0.1.0",
  "description": "面向 AI Agent、自动化脚本、CI 和内部开发者的 CodeHub 命令行客户端",
  "type": "module",
  "bin": {
    "codehub": "./bin/codehub.js"
  },
  "exports": {
    ".": "./src/cli.js"
  },
  "files": [
    "bin",
    "src",
    "docs/PRD.md",
    "docs/API.md",
    "docs/assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:fix": "eslint . --fix --max-warnings 0 && prettier . --write",
    "test": "node --test",
    "test:coverage": "c8 --check-coverage --lines 90 --branches 90 --functions 90 --statements 90 node --test",
    "test:package": "node scripts/package-smoke.mjs",
    "verify": "npm run check && npm run test:coverage && npm run test:package",
    "prepack": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "codehub",
    "cli",
    "automation",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@inquirer/prompts": "7.10.1",
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^14.0.3",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "^10.1.3",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6"
  }
}
